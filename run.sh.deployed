#!/usr/bin/env bash
set -e

APP_DIR="/opt/lgt-amp-sync"
VENV="$APP_DIR/venv"

# Loopback only: cloudflared on this host is the only way in. Auth settings (LGT_AUTH, LGT_CF_TEAM_DOMAIN,
# LGT_CF_AUD, LGT_HOSTNAME) come from the systemd unit; see dev/DEPLOY_NOTES.md.
exec "$VENV/bin/uvicorn" app.main:app \
  --host "${LGT_BIND:-127.0.0.1}" \
  --port 8078
