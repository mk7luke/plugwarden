# Copy to .env (chmod 600). Used by docker-compose.yml. See dev/DEPLOY_NOTES.md.

# Datastore (mounted at the same path inside the container)
LGT_BASE_OVERRIDE=/mnt/storage_ssd/ssd-live

# Cloudflare Access (Zero Trust → Access → Applications → PlugWarden (AMP Sync))
LGT_AUTH=cf-access
LGT_CF_TEAM_DOMAIN=tech-guy.cloudflareaccess.com
LGT_CF_AUD=26625e9b76430b682d8c278b1c8ad95087a23b5f5ac2d3b58ac2a527891bded4

# Public hostname (tunnel ingress bulkupdate.obliv.us → http://localhost:8078); added to the Host allowlist
LGT_HOSTNAME=bulkupdate.obliv.us
# Extra allowed Host headers (comma-separated); localhost and 127.0.0.1 are always allowed
#LGT_ALLOWED_HOSTS=

# Refuse new jobs below this much free space (GB) on the state dir or datastore
#LGT_MIN_FREE_GB=2
# Serve /api/v2/docs
#LGT_DOCS=1
