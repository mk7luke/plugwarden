# Copy to .env (chmod 600). Read by docker-compose.yml. See dev/DEPLOY_NOTES.md.

# --- Container (used by docker-compose.yml itself) ---
# Your AMP datastore on the host. It is mounted at the same path inside the container.
AMP_DATASTORE=/home/amp/.ampdata/instances
# The uid/gid of your AMP user (run: id -u amp ; id -g amp), so files keep their ownership.
PLUGWARDEN_UID=1001
PLUGWARDEN_GID=1001

# --- App ---
# Datastore path as seen by the app (same as AMP_DATASTORE).
LGT_BASE_OVERRIDE=/home/amp/.ampdata/instances

# Cloudflare Access (Zero Trust → Access → Applications → your PlugWarden app)
LGT_AUTH=cf-access
LGT_CF_TEAM_DOMAIN=yourteam.cloudflareaccess.com
LGT_CF_AUD=paste-the-application-audience-aud-tag-here

# Public hostname your Cloudflare Tunnel routes to http://localhost:8078; added to the Host allowlist
LGT_HOSTNAME=plugins.example.com
# Extra allowed Host headers (comma-separated); localhost and 127.0.0.1 are always allowed
#LGT_ALLOWED_HOSTS=

# Contact sent in the User-Agent to Modrinth/Hangar/GitHub (recommended by their API rules)
#LGT_CONTACT=you@example.com

# Refuse new jobs below this much free space (GB) on the state dir or datastore
#LGT_MIN_FREE_GB=2
# Serve /api/v2/docs
#LGT_DOCS=1
